            <Ellipse Fill="{DynamicResource SeasonalPinkBrush}" Width="42" Height="42" Margin="266,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Ellipse Fill="{DynamicResource SeasonalYellowBrush}" Width="14" Height="14" Margin="126,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Ellipse Fill="{DynamicResource SeasonalYellowBrush}" Width="14" Height="14" Margin="203,52,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Ellipse Fill="{DynamicResource SeasonalYellowBrush}" Width="14" Height="14" Margin="280,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Grid>

        <Grid x:Name="SummerShadesSkin" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="4">
            <Rectangle Fill="{DynamicResource SeasonalDarkBrush}" Width="54" Height="30" Margin="139,374,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Fill="{DynamicResource SeasonalDarkBrush}" Width="54" Height="30" Margin="227,374,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Fill="{DynamicResource SeasonalDarkBrush}" Width="34" Height="8" Margin="193,380,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Fill="{DynamicResource SeasonalSnowBrush}" Width="12" Height="6" Margin="147,380,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.65" />
            <Rectangle Fill="{DynamicResource SeasonalSnowBrush}" Width="12" Height="6" Margin="235,380,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.65" />
        </Grid>

        <Grid x:Name="AwakeContent">
        <TextBlock Text="{Binding HeaderText}" Margin="0,105,0,0" VerticalAlignment="Top"
                   HorizontalAlignment="Center" FontFamily="Consolas" FontSize="22"
                   FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
        <Button x:Name="SortButton" Content="↕" ToolTip="Sort tasks"
                Style="{StaticResource PixelButton}" Width="26" Height="26"
                Margin="82,116,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                FontSize="15" Click="SortButton_Click" />
        <Button x:Name="CalendarButton" Content="▦" ToolTip="Calendar"
                Style="{StaticResource PixelButton}" Width="28" Height="28"
                Margin="112,115,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                FontSize="15" Click="CalendarButton_Click" />
        <Button x:Name="AddButton" Content="+" ToolTip="Add task (Ctrl+N / Ctrl+Alt+N) • Clipboard task (Ctrl+Alt+V)"
                Style="{StaticResource PixelButton}" Width="30" Height="30"
                Margin="0,114,84,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                FontSize="20" Click="AddButton_Click" />
        <Button x:Name="SearchButton" Content="⌕" ToolTip="Search and filter tasks"
                Style="{StaticResource PixelButton}" Width="28" Height="28"
                Margin="0,115,118,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                FontSize="16" Click="SearchButton_Click" />
        <!-- Input editor -->
        <Border x:Name="AddPanel" Width="262" Height="42" Margin="0,157,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource InkBrush}" BorderThickness="3"
                Panel.ZIndex="10"
                Visibility="Collapsed">
            <Grid Margin="5,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TaskInput" Grid.Column="0" MaxLength="500"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource InkBrush}"
                         VerticalContentAlignment="Center" KeyDown="TaskInput_KeyDown"
                         ToolTip="Separate multiple tasks with ;" />
                <Button Grid.Column="1" Content="✓" Style="{StaticResource PixelButton}"
                        Margin="3,0,0,0" Click="ConfirmAddButton_Click" />
            </Grid>
        </Border>

        <Border x:Name="FilterPanel" Width="278" Height="108" Margin="0,157,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="20"
                Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="3" Visibility="Collapsed">
            <Grid Margin="5,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="29" />
                    <RowDefinition Height="31" />
                    <RowDefinition Height="31" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TaskSearchBox" Grid.Row="0" Grid.Column="0"
                         FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Center"
                         TextChanged="TaskSearchBox_TextChanged" />
                <Button Grid.Row="0" Grid.Column="1" Content="×" ToolTip="Close filters"
                        Style="{StaticResource PixelButton}" Margin="3,0,0,0"
                        Click="CloseFilterButton_Click" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Content="Active" Tag="Active" Width="55" Margin="2,0"
                            Style="{StaticResource PixelButton}" Click="TaskFilterButton_Click" />
                    <Button Content="Due" Tag="Scheduled" Width="45" Margin="2,0"
                            Style="{StaticResource PixelButton}" Click="TaskFilterButton_Click" />
                    <Button Content="Timer" Tag="RunningTimer" Width="50" Margin="2,0"
                            Style="{StaticResource PixelButton}" Click="TaskFilterButton_Click" />
                    <Button Content="Done" Tag="Completed" Width="48" Margin="2,0"
                            Style="{StaticResource PixelButton}" Click="TaskFilterButton_Click" />
                </StackPanel>
                <ListBox Grid.Row="2" Grid.ColumnSpan="2"
                         ItemsSource="{Binding AvailableCategoryFilters}"
                         SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Height="27"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="{DynamicResource CreamBrush}" />
                            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="Padding" Value="7,2" />
                            <Setter Property="Margin" Value="2,2,2,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Border x:Name="SortPanel" Width="166" Height="43" Margin="112,151,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left" Panel.ZIndex="25"
                Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="3" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4">
                <Button Content="Priority" ToolTip="Sort by priority" Width="82"
                        Style="{StaticResource PixelButton}" Click="SortByPriorityMenuItem_Click" />
                <Button Content="Time" ToolTip="Sort by time" Width="66" Margin="4,0,0,0"
                        Style="{StaticResource PixelButton}" Click="SortByTimeMenuItem_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="CalendarPanel" Width="300" Height="254" Margin="0,148,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="45"
                Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="3" Visibility="Collapsed">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="32" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="‹" ToolTip="Previous" Tag="-1"
                            Style="{StaticResource PixelButton}" Click="CalendarNavigateButton_Click" />
                    <TextBlock Grid.Column="1" Text="{Binding CalendarTitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}" />
                    <Button Grid.Column="2" Content="›" ToolTip="Next" Tag="1" Margin="2,0,0,0"
                            Style="{StaticResource PixelButton}" Click="CalendarNavigateButton_Click" />
                    <Button Grid.Column="3" Content="×" ToolTip="Close calendar" Margin="2,0,0,0"
                            Style="{StaticResource PixelButton}" Click="CloseCalendarButton_Click" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
                    <Button Content="Day" Tag="Day" Width="58" Margin="2,0"
                            Style="{StaticResource PixelButton}" Click="CalendarModeButton_Click" />
                    <Button Content="Week" Tag="Week" Width="58" Margin="2,0"
                            Style="{StaticResource PixelButton}" Click="CalendarModeButton_Click" />
                    <Button Content="Today" Tag="Today" Width="62" Margin="2,0"
                            Style="{StaticResource PixelButton}" Click="CalendarModeButton_Click" />
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <TextBlock Text="{Binding CalendarEmptyText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"
                               Foreground="{DynamicResource MutedInkBrush}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CalendarEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Task}" Click="CalendarTaskButton_Click"
                                            Height="29" Margin="0,0,0,3" Padding="4,0"
                                            Background="{DynamicResource TaskBrush}" BorderThickness="0"
                                            Cursor="Hand" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="43" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DayLabel}" FontFamily="Consolas" FontSize="10"
                                                       FontWeight="Bold" Foreground="{DynamicResource MutedInkBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontFamily="Consolas"
                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SeedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Consolas"
                                                       FontSize="12" Foreground="{DynamicResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Five rows fit at once; the mouse wheel reveals the remaining tasks. -->
        <Border x:Name="TaskListBorder" Width="278" Height="180" Margin="0,166,0,0" VerticalAlignment="Top"
                HorizontalAlignment="Center" ClipToBounds="True">
            <ScrollViewer x:Name="TaskScrollViewer"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PanningMode="VerticalOnly">
                <ItemsControl x:Name="TaskItemsControl" ItemsSource="{Binding TasksView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TaskRow" Height="33" MinHeight="33" Margin="0,0,0,3" Background="{DynamicResource TaskBrush}"
                                    BorderBrush="{DynamicResource MiddleBrush}" BorderThickness="0,0,0,2"
                                    AllowDrop="True" Cursor="Hand" ToolTip="{Binding TaskToolTip}"
                                    PreviewMouseLeftButtonDown="TaskRow_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="TaskRow_PreviewMouseLeftButtonUp"
                                    PreviewMouseMove="TaskRow_PreviewMouseMove"
                                    DragOver="TaskRow_DragOver" Drop="TaskRow_Drop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="33" />
                                        <RowDefinition>
                                            <RowDefinition.Style>
                                                <Style TargetType="RowDefinition">
                                                    <Setter Property="Height" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Height" Value="Auto" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RowDefinition.Style>
                                        </RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              IsChecked="{Binding IsCompleted}" Click="TaskCheckBox_Click" />
                                    <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource SeedBrush}" Margin="0,0,4,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ReminderLabel}"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedInkBrush}" Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <local:LinkTextBlock LinkText="{Binding Text}"
                                               FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource InkBrush}"
                                               >
                                        <local:LinkTextBlock.Style>
                                            <Style TargetType="local:LinkTextBlock">
                                                <Setter Property="Grid.Row" Value="0" />
                                                <Setter Property="Grid.Column" Value="3" />
                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                <Setter Property="Margin" Value="0,3" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Setter Property="Grid.Column" Value="0" />
                                                        <Setter Property="Grid.ColumnSpan" Value="7" />
                                                        <Setter Property="Margin" Value="8,2,8,7" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                                                        <Setter Property="TextTrimming" Value="None" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </local:LinkTextBlock.Style>
                                    </local:LinkTextBlock>
                                    <Button Grid.Column="4" Content="{Binding TimerIcon}"
                                            ToolTip="{Binding TimerToolTip}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource InkBrush}" FontFamily="Consolas"
                                            FontSize="15" FontWeight="Bold" Cursor="Hand"
                                            Tag="{Binding}" Click="TaskTimerButton_Click" />
                                    <Button Grid.Column="5" Content="{Binding PinIcon}" ToolTip="{Binding PinToolTip}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource SeedBrush}" FontFamily="Consolas"
                                            FontSize="13" FontWeight="Bold" Cursor="Hand"
                                            Tag="{Binding}" Click="PinTaskButton_Click" />
                                    <Button x:Name="TaskActionsButton" Grid.Column="6" Content="•••"
                                            ToolTip="Task actions" Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource InkBrush}" FontFamily="Consolas"
                                            FontSize="13" FontWeight="Bold" Cursor="Hand"
                                            Tag="{Binding}" Click="TaskActionsButton_Click" />
                                    <Popup Grid.Column="6" IsOpen="{Binding IsActionsOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=TaskActionsButton}"
                                           Placement="Left" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource CreamBrush}"
                                                BorderBrush="{DynamicResource InkBrush}" BorderThickness="2"
                                                Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="⧉" ToolTip="Duplicate task" Width="30" Height="28"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource InkBrush}" FontFamily="Consolas"
                                                        FontSize="15" FontWeight="Bold" Cursor="Hand"
                                                        Tag="{Binding}" Click="DuplicateTaskButton_Click" />
                                                <Button Content="✎" ToolTip="Edit task" Width="30" Height="28"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource InkBrush}" FontFamily="Consolas"
                                                        FontSize="15" FontWeight="Bold" Cursor="Hand"
                                                        Tag="{Binding}" Click="EditTaskButton_Click" />
                                                <Button Content="×" ToolTip="Delete task" Width="30" Height="28"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource SeedBrush}" FontFamily="Consolas"
                                                        FontSize="18" Cursor="Hand"
                                                        Tag="{Binding}" Click="DeleteTaskButton_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="OverflowText" Text="{Binding OverflowLabel}" Margin="0,350,0,0" VerticalAlignment="Top"
                   HorizontalAlignment="Center" FontFamily="Consolas" FontSize="12"
                   FontWeight="Bold" Foreground="{DynamicResource MutedInkBrush}"
                   ToolTip="Use the mouse wheel to see hidden tasks" />

        <Grid x:Name="AdaptiveFacePanel" Width="118" Height="58" Margin="0,378,0,0"
              VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="2"
              IsHitTestVisible="False" ToolTip="{Binding AdaptiveStatus}">
            <TextBlock Text="{Binding AdaptiveEyes}" HorizontalAlignment="Center" VerticalAlignment="Top"
                       FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding AdaptiveMouth}" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,22,0,0" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource MutedInkBrush}" />
        </Grid>

        <Border x:Name="SnoozePanel" Width="278" Height="78" Margin="0,366,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="30"
                Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="3" Visibility="Collapsed">
            <StackPanel Margin="6,4">
                <TextBlock Text="{Binding AlertTaskLabel}" FontFamily="Consolas" FontSize="12"
                           FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Button Content="5m" Tag="5" ToolTip="Snooze 5 minutes" Style="{StaticResource PixelButton}"
                            Width="42" Height="28" Margin="2,0" Click="SnoozeButton_Click" />
                    <Button Content="10m" Tag="10" ToolTip="Snooze 10 minutes" Style="{StaticResource PixelButton}"
                            Width="45" Height="28" Margin="2,0" Click="SnoozeButton_Click" />
                    <Button Content="30m" Tag="30" ToolTip="Snooze 30 minutes" Style="{StaticResource PixelButton}"
                            Width="45" Height="28" Margin="2,0" Click="SnoozeButton_Click" />
                    <Button Content="OK" ToolTip="Dismiss reminder" Style="{StaticResource PixelButton}"
                            Width="42" Height="28" Margin="2,0" Click="DismissReminderButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ArchivePanel" Width="286" Height="226" Margin="0,148,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="40"
                Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="3" Visibility="Collapsed">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="COMPLETED" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                <Button Grid.Row="0" Content="×" ToolTip="Close archive" Width="26" Height="26"
                        HorizontalAlignment="Right" Style="{StaticResource PixelButton}"
                        Click="CloseArchiveButton_Click" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ArchivedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32" Background="{DynamicResource TaskBrush}" Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text}" ToolTip="{Binding CreatedToolTip}"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="5,0" />
                                    <Button Grid.Column="1" Content="↶" ToolTip="Restore task" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource InkBrush}" FontSize="16"
                                            Click="RestoreArchivedTaskButton_Click" />
                                    <Button Grid.Column="2" Content="×" ToolTip="Delete permanently" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource SeedBrush}" FontSize="17"
                                            Click="DeleteArchivedTaskButton_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>

        <Grid x:Name="SleepOverlay" Panel.ZIndex="20" Visibility="Collapsed"
              Opacity="0" IsHitTestVisible="False">
            <TextBlock Text="z" Margin="0,150,108,0" VerticalAlignment="Top"
                       HorizontalAlignment="Right" FontFamily="Consolas" FontSize="18"
                       FontWeight="Bold" Foreground="{DynamicResource MutedInkBrush}" />
            <TextBlock Text="Z" Margin="0,125,78,0" VerticalAlignment="Top"
                       HorizontalAlignment="Right" FontFamily="Consolas" FontSize="25"
                       FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding SleepEyes}" Width="48" Margin="128,204,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" TextAlignment="Center"
                       FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding SleepEyes}" Width="48" Margin="242,204,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" TextAlignment="Center"
                       FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding SleepMouth}" Width="52" Margin="184,254,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" TextAlignment="Center"
                       FontFamily="Consolas" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource MutedInkBrush}" />
            <TextBlock Text="{Binding SleepTimerText}" Margin="0,306,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                       FontFamily="Consolas" FontSize="34" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding SleepTaskCountText}" Width="220" Height="180"
                       Margin="0,300,0,0" Panel.ZIndex="25"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       TextAlignment="Center"
                       FontFamily="Consolas" FontSize="144" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
        </Grid>

        <Border x:Name="FruitContextMenu" Panel.ZIndex="30" Visibility="Collapsed"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="{DynamicResource CreamBrush}" BorderBrush="{DynamicResource InkBrush}"
                BorderThickness="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Button Content="Sleep" Width="118" Height="32"
                        Style="{StaticResource PixelButton}"
                        Click="FruitSleepMenuItem_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
